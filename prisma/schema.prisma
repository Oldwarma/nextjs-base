// Prisma Schema for NextJS Base Admin
// 
// 本 Schema 主要包含：
// 1. Better Auth 相关表（users, sessions, accounts, verifications）
// 2. RBAC 权限系统（roles, permissions, menus）
// 3. System 系统管理（assets, action_logs）

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Better Auth 相关表
// ============================================

/// 用户表 - Better Auth 核心表
model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  emailVerified      Boolean   @default(false)
  name               String?
  username           String?   @unique
  image              String?
  
  // 角色与权限
  role               String    @default("user")        // 基础角色: user, admin
  roles              String[]  @default([])            // RBAC 角色 ID 数组
  isBackendAllowed   Boolean   @default(false)         // 是否允许访问后台
  
  // 积分系统（可选，后续扩展用）
  credits            Int       @default(0)
  totalCreditsEarned Int       @default(0)
  totalCreditsUsed   Int       @default(0)
  
  // 套餐系统（可选，后续扩展用）
  currentPackageId   String?
  packageExpireAt    DateTime?
  
  // 封禁相关
  banned             Boolean   @default(false)
  banReason          String?
  banExpires         DateTime?
  
  // 时间戳
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  // 关联
  sessions           Session[]
  accounts           Account[]
  actionLogs         ActionLog[]
  assets             Asset[]
  
  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// 会话表 - Better Auth 会话管理
model Session {
  id             String    @id @default(uuid())
  userId         String
  token          String    @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@map("sessions")
}

/// 账户表 - Better Auth OAuth 账户关联
model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// 验证表 - Better Auth 邮箱验证/密码重置
model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  @@index([identifier])
  @@map("verifications")
}

// ============================================
// RBAC 权限系统
// ============================================

/// 角色表
model Role {
  id                     String    @id @default(uuid())
  name                   String    @unique
  parentId               String?   @map("parent_id")
  parent                 Role?     @relation("RoleHierarchy", fields: [parentId], references: [id])
  children               Role[]    @relation("RoleHierarchy")
  remark                 String?
  enable                 Boolean   @default(true)
  
  // 权限和菜单（存储 ID 数组）
  permission             String[]  @default([])         // 权限 ID 数组
  menu                   String[]  @default([])         // 菜单 ID 数组
  inheritMenuPermissions Boolean   @default(false)      // 是否继承菜单关联的权限
  
  // 时间戳
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?                      // 软删除时间
  
  @@index([parentId])
  @@index([name])
  @@index([enable])
  @@index([deletedAt])
  @@map("roles")
}

/// 权限表（树形结构）
model Permission {
  id            String    @id @default(uuid())
  name          String
  parentId      String?   @map("parent_id")
  remark        String?
  enable        Boolean   @default(true)
  sort          Int       @default(0)
  
  // 权限分类和级别
  crudCategory  Int       @default(0) @map("crud_category")   // 0-5: 无/查询/创建/更新/删除/全部
  level         Int       @default(0)                         // 0-4: 普通/敏感/高危/超级/系统
  
  // 关联的 actions 和 apis
  actions       String[]  @default([])                        // Server Action 名称数组
  apis          String[]  @default([])                        // API 路径数组
  
  // 时间戳
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?                                     // 软删除时间
  
  @@unique([name, parentId])
  @@index([parentId])
  @@index([enable])
  @@index([sort])
  @@index([deletedAt])
  @@map("permissions")
}

/// 菜单表（树形结构）
model Menu {
  id         String    @id @default(uuid())
  name       String
  parentId   String?   @map("parent_id")
  url        String?
  icon       String?
  sort       Int       @default(0)
  enable     Boolean   @default(true)
  hidden     Boolean   @default(false)
  remark     String?
  
  // 菜单关联的权限
  permission String[]  @default([])                           // 权限 ID 数组
  
  // 时间戳
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?                                        // 软删除时间
  
  @@index([parentId])
  @@index([enable])
  @@index([sort])
  @@index([deletedAt])
  @@map("menus")
}

// ============================================
// System 系统管理
// ============================================

/// 素材/文件表
model Asset {
  id           String    @id @default(uuid())
  
  // 文件信息
  originalName String    @map("original_name")
  filename     String
  key          String    @unique                              // R2/S3 存储 key
  url          String
  type         String                                         // image, video, document, audio, other
  mimeType     String    @map("mime_type")
  size         Int                                            // 文件大小（字节）
  
  // 图片特有信息
  width        Int?
  height       Int?
  
  // 关联用户
  userId       String?   @map("user_id")
  remark       String?
  
  // 时间戳
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("assets")
}

/// 上传频率/封禁控制
model UploadGuard {
  id          String    @id @default(uuid())
  type        String                                        // user/ip
  value       String
  windowStart DateTime  @map("window_start")
  count       Int       @default(0)
  bannedUntil DateTime? @map("banned_until")
  banReason   String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([type, value])
  @@index([bannedUntil])
  @@map("upload_guard")
}

/// 操作日志表
model ActionLog {
  id           String    @id @default(uuid())
  
  // 操作信息
  userId       String    @map("user_id")
  action       String                                         // create, update, delete, query 等
  resourceType String    @map("resource_type")                // 资源类型: user, role, permission 等
  resourceId   String?   @map("resource_id")
  
  // 请求和响应
  params       Json?     @default("{}")                       // 请求参数
  result       Json?     @default("{}")                       // 返回结果
  
  // 状态
  success      Boolean   @default(true)
  duration     Int       @default(0)                          // 执行时长（毫秒）
  
  // 客户端信息
  ip           String?
  userAgent    String?   @map("user_agent")
  
  // 时间戳
  createdAt    DateTime  @default(now())
  
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("action_logs")
}

// ============================================
// CMS 内容管理
// ============================================

/// 文章表 - CMS 示例
model Post {
  id          String    @id @default(uuid())
  name        String
  status      String    @default("active")                    // active, inactive, draft
  order       Int       @default(0)
  expiresAt   DateTime? @map("expires_at")
  description String?
  content     String?
  
  // 时间戳
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?                                       // 软删除时间
  
  @@index([status])
  @@index([order])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("posts")
}

// ============================================
// Example 示例数据
// ============================================

/// 示例数据表 - SmartCrudPage 完整功能演示
model ExampleData {
  id                   String    @id @default(uuid())
  
  // 基础信息
  title                String
  description          String?
  status               String    @default("draft")            // draft, pending, published, archived
  
  // 分类信息
  category             String?                                // electronics, clothing, food, books, sports, other
  subCategory          String?   @map("sub_category")
  
  // 联系信息
  contactType          String?   @map("contact_type")         // email, phone, wechat, none
  email                String?
  phone                String?
  wechat               String?
  address              String?
  
  // 价格信息
  price                Decimal?  @db.Decimal(10, 2)
  discount             Decimal?  @db.Decimal(5, 2)
  quantity             Int?      @default(0)
  
  // 属性信息
  priority             String?                                // low, medium, high, urgent
  features             String[]  @default([])                 // 功能特性数组
  tags                 String[]  @default([])                 // 标签数组
  
  // 组织信息
  department           String?
  location             String[]  @default([])                 // 地区级联数据
  
  // 日期时间
  publishDate          DateTime? @map("publish_date")
  eventTime            DateTime? @map("event_time")
  validPeriod          String[]  @default([])  @map("valid_period")  // 有效期范围
  
  // 开关状态
  isActive             Boolean   @default(true)  @map("is_active")
  isPublic             Boolean   @default(false) @map("is_public")
  isVip                Boolean   @default(false) @map("is_vip")
  enableNotification   Boolean   @default(false) @map("enable_notification")
  
  // 媒体文件 - 上传
  coverImage           String?   @map("cover_image")
  gallery              String[]  @default([])                 // 多图数组
  avatar               String?
  documents            String[]  @default([])                 // 文档数组
  attachments          String[]  @default([])                 // 附件数组
  
  // 媒体文件 - 从库选择
  selectedImage        String?   @map("selected_image")
  selectedGallery      String[]  @default([]) @map("selected_gallery")
  selectedAvatar       String?   @map("selected_avatar")
  selectedFiles        String[]  @default([]) @map("selected_files")
  
  // 高级字段
  rating               Decimal?  @db.Decimal(2, 1)            // 评分 0-5
  color                String?                                // 颜色
  icon                 String?                                // 图标
  
  // 内容字段
  richContent          String?   @map("rich_content")         // Markdown 富文本
  
  // 数据字段
  keywords             String[]  @default([])                 // 关键词数组
  metadata             Json?                                  // JSON 元数据
  
  // 时间戳
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?                              // 软删除时间
  
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([isActive])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("example_data")
}
