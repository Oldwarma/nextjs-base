# ===========================================
# NextJS Base - Environment Variables Example
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# Database Configuration
# ===========================================

# PostgreSQL (Prisma)
# Local: postgresql://username:password@localhost:5432/nextjs_base
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Neon: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:eaijV$WbHJX3WQp@localhost:5432/nextjs_base?schema=public"

# ===========================================
# Authentication (Better Auth)
# ===========================================

# Secret key for Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="9f2c3e7d0a6b4c0e8e5d1a9f3c7b2e4a6d8f9a1c0e3b4a5d6f7e8c9a0b1c2"

# Base URL for Better Auth
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# ===========================================
# OAuth Providers (Optional)
# ===========================================

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===========================================
# File Upload (Cloudflare R2)
# ===========================================

# R2 Configuration
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# UPLOAD_RATE_LIMIT_PER_MINUTE（或 UPLOAD_RATE_LIMIT）: 单窗口最大上传次数，<=0 关闭限流。
UPLOAD_RATE_LIMIT=10
# UPLOAD_RATE_WINDOW_SECONDS：窗口时长（默认 60 秒）。
# UPLOAD_RATE_BAN_DURATION：超限封禁时长，0 不封禁，-1 永久封禁，正整数为分钟数。
UPLOAD_RATE_BAN_DURATION=10


# ===========================================
# Action Logger Configuration
# ===========================================

# Log mode: full | summary | simple
ACTION_LOG_MODE="full"
# Log depth: 1-5 or null (unlimited)
ACTION_LOG_DEPTH=""
# Database logging: 1 (enabled) | 0 (disabled)
ACTION_LOG_DATABASE="1"
# Max log records: 0 (unlimited) or number
ACTION_LOG_MAX="1000"
# Log types: all | create,read,update,delete
ACTION_LOG_TYPE="all"

# ===========================================
# Development
# ===========================================

NODE_ENV="development"
